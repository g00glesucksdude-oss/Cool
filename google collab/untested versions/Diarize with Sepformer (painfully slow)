def find_transcript_file(seg_filename: str, transcripts_dirs: list):
    stem = os.path.splitext(seg_filename)[0]
    for d in transcripts_dirs:
        groq_path = os.path.join(d, f"{stem}_transcript.txt")
        if os.path.exists(groq_path):
            return groq_path, "groq"
        colab_path = os.path.join(d, f"{stem}.txt")
        if os.path.exists(colab_path):
            return colab_path, "colab"
    return None, None


def is_local_transcript_complete(path: str, expected_duration_sec: float, tolerance: float = 0.75) -> bool:
    """True if a local (faster-whisper) transcript appears to cover the whole segment.
    Local files use relative timestamps starting at ~0.0 for the slice, so the
    last end-time should be close to the segment duration. Empty / non-timestamped
    / truncated files are treated as incomplete."""
    try:
        with open(path, "r", encoding="utf-8") as f:
            content = f.read().strip()
    except OSError:
        return False
    if not content:
        return False
    ends = [float(m.group(2)) for m in COLAB_LINE_RE.finditer(content)]
    if not ends:
        # No timestamp lines at all (corrupt / hand-edited / empty progress) → incomplete
        return False
    last_end = max(ends)
    return last_end >= (expected_duration_sec - tolerance)


def cleanup_incomplete_local_transcripts(manifest: dict, transcripts_dirs: list) -> int:
    """When switching to Groq (or any non-local backend), remove partial local
    faster-whisper transcripts so those segments are treated as missing and
    get re-transcribed cleanly. Also clears matching entries from
    local_resume_state.json.

    Returns the number of partial files removed."""
    state = load_local_resume_state()
    removed = 0
    keys_to_drop = []

    for seg in manifest.get("segments", []):
        stem = os.path.splitext(seg["file"])[0]
        expected_dur = float(seg["end_sec"]) - float(seg["start_sec"])

        for d in transcripts_dirs:
            local_path = os.path.join(d, f"{stem}.txt")
            if not os.path.exists(local_path):
                continue
            # Already have a finished Groq transcript? Leave the local one alone.
            groq_path = os.path.join(d, f"{stem}_transcript.txt")
            if os.path.exists(groq_path):
                continue

            if is_local_transcript_complete(local_path, expected_dur):
                continue

            # Incomplete → delete so Groq (or a fresh local run) will redo it
            try:
                os.remove(local_path)
                removed += 1
                print(f"  [~] Removed incomplete local transcript: {os.path.basename(local_path)} "
                      f"(will be re-transcribed by the new backend)")
            except OSError as e:
                print(f"  [!] Could not remove partial {local_path}: {e}")
                continue

            # Drop any resume-state keys that point at this stem / path
            for k in list(state.keys()):
                if stem in k or k == local_path or k.endswith(f"{stem}.txt"):
                    keys_to_drop.append(k)

    for k in keys_to_drop:
        state.pop(k, None)
    if keys_to_drop:
        save_local_resume_state(state)

    return removed


def export_flac_under_limit(seg_path: str, tmp_path: str) -> str:
    from pydub import AudioSegment
    audio = AudioSegment.from_file(seg_path)
    try:
        audio.export(tmp_path, format="flac")
        if os.path.getsize(tmp_path) <= MAX_CHUNK_BYTES:
            return tmp_path
        print(f"[!] '{seg_path}' exceeds Groq's size limit even as FLAC - truncating to first half.")
        half = audio[:len(audio) // 2]
        half.export(tmp_path, format="flac")
        return tmp_path
    finally:
        del audio


def transcribe_segment_groq(client_holder: dict, api_keys: list, seg_path: str, model_id: str,
                            prompt_context: str, fixed_language: str = None, lock: threading.Lock = None):
    """Returns (text, detected_lang). client_holder = {'client': Groq, 'key_index': int},
    mutated in place so key rotation persists across calls within one run.
    Optional lock makes this safe under ThreadPoolExecutor."""
    tmp_path = seg_path + f".groqtmp.{os.getpid()}.{threading.get_ident()}.flac"
    export_flac_under_limit(seg_path, tmp_path)

    kwargs = {
        "model": model_id,
        "response_format": "verbose_json",
        "prompt": prompt_context[-CONTEXT_CHARS:] if prompt_context else None,
    }
    # Groq Whisper accepts language as ISO-639-1 when you want to pin it
    if fixed_language:
        kwargs["language"] = fixed_language

    while True:
        try:
            with open(tmp_path, "rb") as audio_file:
                data = audio_file.read()
            # Hold lock only around the API call + key rotation, not file I/O
            def _call():
                return client_holder["client"].audio.transcriptions.create(
                    file=(os.path.basename(tmp_path), data),
                    **kwargs,
                )
            if lock:
                with lock:
                    response = _call()
            else:
                response = _call()
            text = response.text.strip()
            lang = getattr(response, "language", None) or fixed_language
            if os.path.exists(tmp_path):
                os.remove(tmp_path)
            return text, lang

        except Exception as e:
            if is_quota_or_rate_limit_error(e):
                print(f"[!] Key '{client_holder['key_index']+1}' hit a rate limit/quota error: {e}")
                time.sleep(RATE_LIMIT_COOLDOWN_SEC)
                if lock:
                    lock.acquire()
                try:
                    client_holder["key_index"] += 1
                    if client_holder["key_index"] >= len(api_keys):
                        if os.path.exists(tmp_path):
                            os.remove(tmp_path)
                        raise RuntimeError("All available Groq API keys are exhausted for now.")
                    print(f"[+] Switching to key {client_holder['key_index']+1}/{len(api_keys)}...")
                    from groq import Groq
                    client_holder["client"] = Groq(api_key=api_keys[client_holder["key_index"]])
                finally:
                    if lock:
                        lock.release()
                continue
            else:
                if os.path.exists(tmp_path):
                    os.remove(tmp_path)
                raise


_transcribe_model_cache = {}


def get_transcribe_model(style: str):
    """style: 'turbo' or 'large'. Mirrors the original Colab script's GPU/T4-
    aware model + quantization selection exactly, with a CPU fallback to
    'small'/int8 regardless of style (same as the original)."""
    import torch

    cache_key = style
    if cache_key in _transcribe_model_cache:
        return _transcribe_model_cache[cache_key]

    from faster_whisper import WhisperModel

    if torch.cuda.is_available():
        gpu_name = torch.cuda.get_device_name(0)
        print(f"[+] GPU detected ({gpu_name}).")
        is_t4 = "T4" in gpu_name
        if style == "turbo":
            if is_t4:
                print("[+] T4 detected - using int8_float16 quantization on 'medium' for better speed...")
                model = WhisperModel("medium", device="cuda", compute_type="int8_float16")
            else:
                print("[+] Loading faster-whisper on GPU (int8_float16, large-v3-turbo)...")
                model = WhisperModel("large-v3-turbo", device="cuda", compute_type="int8_float16")
        else:  # large - full accuracy
            if is_t4:
                print("[+] T4 detected - using int8_float16 quantization on large-v3 (full accuracy, slower)...")
                model = WhisperModel("large-v3", device="cuda", compute_type="int8_float16")
            else:
                print("[+] Loading faster-whisper on GPU (float16, large-v3)...")
                model = WhisperModel("large-v3", device="cuda", compute_type="float16")
    else:
        print("[!] CPU-only (no GPU attached). Loading faster-whisper 'small' (int8) regardless of style chosen.")
        model = WhisperModel("small", device="cpu", compute_type="int8")

    _transcribe_model_cache[cache_key] = model
    return model


def load_local_resume_state() -> dict:
    if not os.path.exists(LOCAL_RESUME_FILE):
        return {}
    try:
        with open(LOCAL_RESUME_FILE, "r", encoding="utf-8") as f:
            return json.load(f)
    except (json.JSONDecodeError, OSError):
        return {}


def save_local_resume_state(state: dict):
    with open(LOCAL_RESUME_FILE, "w", encoding="utf-8") as f:
        json.dump(state, f, indent=2)


def transcribe_segment_local(model, seg_path: str, out_path: str, initial_prompt: str,
                             fixed_language: str = None):
    """Writes '[start -> end] text' lines to out_path progressively (flush +
    fsync per line), and tracks a resume state on Drive keyed by the stable
    transcript path (out_path) so mid-segment resume still works when audio
    is reconstructed from different temp slice paths each run.

    If a prior run was interrupted mid-segment, seeks past the completed
    portion via ffmpeg (exact re-encode seek, same technique as the original
    Colab script - not '-c copy', which snaps to the nearest keyframe) and
    continues appending rather than restarting the whole segment. Returns the
    full segment text and the last detected language.

    fixed_language: ISO code (e.g. 'en') forces that language — no per-segment
    redetect / switch. None = auto-detect.
    """
    state = load_local_resume_state()
    # Prefer stable transcript-path key; fall back to legacy audio-path key
    entry = state.get(out_path) or state.get(seg_path) or {"last_end": 0.0, "done": False}

    if entry.get("done") and os.path.exists(out_path):
        with open(out_path, "r", encoding="utf-8") as f:
            content = f.read()
        lines = [m.group(3) for m in COLAB_LINE_RE.finditer(content)] if content else []
        return " ".join(lines).strip(), fixed_language

    resume_offset = float(entry.get("last_end", 0.0))
    process_path = seg_path
    if resume_offset > 0:
        resume_tmp = seg_path + ".resume.wav"
        try:
            subprocess.run(
                ["ffmpeg", "-y", "-i", seg_path, "-ss", str(resume_offset), resume_tmp],
                check=True, capture_output=True,
            )
            process_path = resume_tmp
            print(f"    [+] Resuming this segment from {resume_offset:.2f}s (previous run was interrupted).")
        except Exception as e:
            print(f"    [!] Couldn't seek to resume point ({e}) - restarting this segment from scratch.")
            resume_offset = 0.0
            process_path = seg_path

    mode = "a" if resume_offset > 0 else "w"
    segments, info = model.transcribe(
        process_path,
        beam_size=1,
        language=fixed_language,  # None = auto; set = stick to one language
        vad_filter=True,          # skip pure silence → faster
        condition_on_previous_text=False,
        initial_prompt=initial_prompt[-CONTEXT_CHARS:] if initial_prompt else None,
    )

    all_text = []
    with open(out_path, mode, encoding="utf-8") as f_out:
        for seg in segments:
            start, end = seg.start + resume_offset, seg.end + resume_offset
            text = seg.text.strip()
            all_text.append(text)
            f_out.write(f"[{start:.2f}s -> {end:.2f}s] {text}\n")
            f_out.flush()
            os.fsync(f_out.fileno())

            entry["last_end"] = end
            # Always write under the stable transcript path
            state[out_path] = entry
            # Drop any legacy audio-path key so state stays clean
            if seg_path in state and seg_path != out_path:
                state.pop(seg_path, None)
            save_local_resume_state(state)

    entry["done"] = True
    state[out_path] = entry
    if seg_path in state and seg_path != out_path:
        state.pop(seg_path, None)
    save_local_resume_state(state)

    if process_path != seg_path and os.path.exists(process_path):
        os.remove(process_path)

    # if we resumed, all_text only has the NEW portion - read the full file back for context purposes
    if resume_offset > 0:
        with open(out_path, "r", encoding="utf-8") as f:
            content = f.read()
        all_text = [m.group(3) for m in COLAB_LINE_RE.finditer(content)]

    lang = fixed_language or getattr(info, "language", None)
    return " ".join(all_text).strip(), lang


def seed_initial_context(manifest_path: str, transcripts_dirs: list, first_missing_index: int) -> str:
    """Builds trailing context from whatever segments before the first missing
    one already have a transcript, so continuity isn't lost just because some
    segments were done in a prior run or hand-dropped in."""
    entries, _, _ = build_entries(manifest_path, transcripts_dirs)
    with open(manifest_path, "r", encoding="utf-8") as f:
        manifest = json.load(f)
    cutoff_start = manifest["segments"][first_missing_index]["start_sec"] if first_missing_index < len(manifest["segments"]) else None
    prior_text = " ".join(e["text"] for e in entries if cutoff_start is None or e["start"] < cutoff_start)
    return prior_text[-CONTEXT_CHARS:] if prior_text else ""


def auto_transcribe_missing(manifest_path: str, transcripts_dirs: list, backend: str, style: str,
                            fixed_language: str = None, parallel_workers: int = 1) -> int:
    """Transcribes any segment in the manifest that doesn't already have a
    transcript file in transcripts_dirs.

    fixed_language: ISO code (e.g. 'en') locks language for the whole run —
      no switch detection, context never dropped for language reasons.
    parallel_workers: >1 enables concurrent Groq API calls (big speedup).
      Local GPU stays sequential (one model); slices are still prefetched.

    Returns count newly transcribed.
    """
    with open(manifest_path, "r", encoding="utf-8") as f:
        manifest = json.load(f)

    seg_dir = os.path.dirname(manifest_path)
    all_segments = manifest["segments"]

    if backend == "groq":
        n_cleaned = cleanup_incomplete_local_transcripts(manifest, transcripts_dirs)
        if n_cleaned:
            print(f"[+] Cleaned {n_cleaned} incomplete local transcript(s) so Groq can redo them.")

    missing_indices = [
        i for i, seg in enumerate(all_segments)
        if find_transcript_file(seg["file"], transcripts_dirs)[0] is None
    ]

    if not missing_indices:
        print("[+] Every segment already has a transcript.")
        return 0

    workers = max(1, int(parallel_workers or 1))
    # Local Whisper on one GPU cannot usefully parallelize inference
    if backend == "local" and workers > 1:
        print("[~] Local GPU transcription stays sequential (one model). "
              "Parallel workers apply to Groq / slice prefetch only.")
        workers = 1

    lang_note = f", language={fixed_language}" if fixed_language else ", language=auto"
    print(f"[+] {len(missing_indices)} segment(s) need transcribing "
          f"(backend: {backend}, style: {style}{lang_note}, workers: {workers}).")

    unload_langid_model()
    free_memory(aggressive=True)

    client_holder = None
    api_keys = []
    local_model = None
    model_id = None
    api_lock = threading.Lock()

    try:
        if backend == "groq":
            api_keys = select_groq_keys()
            from groq import Groq
            client_holder = {"client": Groq(api_key=api_keys[0]), "key_index": 0}
            model_id = GROQ_MODEL_IDS[style]
        else:
            local_model = get_transcribe_model(style)

        seed_ctx = seed_initial_context(manifest_path, transcripts_dirs, missing_indices[0])
        stick_lang = bool(fixed_language)

        # ---------- PARALLEL GROQ PATH ----------
        if backend == "groq" and workers > 1:
            print(f"[+] Parallel Groq mode ({workers} workers). "
                  "Cross-segment context uses seed only (speed > sequential continuity).")

            def _work(n_idx_pair):
                n, idx = n_idx_pair
                seg = all_segments[idx]
                stem = os.path.splitext(seg["file"])[0]
                seg_path, is_temp = get_segment_audio_path(manifest, seg, seg_dir)
                try:
                    print(f"  [{n}/{len(missing_indices)}] Transcribing {seg['file']} "
                          f"({seg['start_sec']:.2f}s-{seg['end_sec']:.2f}s) (groq/{style})...")
                    text, lang = transcribe_segment_groq(
                        client_holder, api_keys, seg_path, model_id, seed_ctx,
                        fixed_language=fixed_language, lock=api_lock,
                    )
                    out_path = os.path.join(DEFAULT_TRANSCRIPTS_DIR, f"{stem}_transcript.txt")
                    with open(out_path, "w", encoding="utf-8") as f:
                        f.write(text)
                    return idx, text, lang or fixed_language, None
                except Exception as e:
                    return idx, None, None, e
                finally:
                    if is_temp and seg_path and os.path.exists(seg_path):
                        try:
                            os.remove(seg_path)
                        except OSError:
                            pass

            done_count = 0
            with ThreadPoolExecutor(max_workers=workers) as pool:
                futs = {
                    pool.submit(_work, (n, idx)): idx
                    for n, idx in enumerate(missing_indices, 1)
                }
                for fut in as_completed(futs):
                    idx, text, lang, err = fut.result()
                    if err is not None:
                        print(f"[!] Failed on segment index {idx}: {err}")
                        continue
                    if lang:
                        all_segments[idx]["language"] = lang
                    done_count += 1

            with open(manifest_path, "w", encoding="utf-8") as f:
                json.dump(manifest, f, indent=2)
            return done_count

        # ---------- SEQUENTIAL PATH (local, or Groq workers=1) ----------
        running_context = seed_ctx
        last_lang = fixed_language
        done_count = 0

        for n, idx in enumerate(missing_indices, 1):
            seg = all_segments[idx]
            stem = os.path.splitext(seg["file"])[0]
            print(f"  [{n}/{len(missing_indices)}] Transcribing {seg['file']} "
                  f"({seg['start_sec']:.2f}s-{seg['end_sec']:.2f}s) ({backend}/{style})...")

            seg_path = None
            is_temp = False
            try:
                seg_path, is_temp = get_segment_audio_path(manifest, seg, seg_dir)

                if backend == "groq":
                    text, lang = transcribe_segment_groq(
                        client_holder, api_keys, seg_path, model_id, running_context,
                        fixed_language=fixed_language, lock=None,
                    )
                    out_path = os.path.join(DEFAULT_TRANSCRIPTS_DIR, f"{stem}_transcript.txt")
                    with open(out_path, "w", encoding="utf-8") as f:
                        f.write(text)
                else:
                    out_path = os.path.join(DEFAULT_TRANSCRIPTS_DIR, f"{stem}.txt")
                    text, lang = transcribe_segment_local(
                        local_model, seg_path, out_path, running_context,
                        fixed_language=fixed_language,
                    )

                # Language-switch context drop — skipped when language is pinned
                if (not stick_lang) and lang and last_lang and lang != last_lang:
                    print(f"    [~] Language switch detected: '{last_lang}' -> '{lang}' "
                          f"(dropping context for continuity)")
                    running_context = ""
                else:
                    running_context = (running_context + " " + text).strip()
                if lang:
                    last_lang = lang
                    seg["language"] = lang

                done_count += 1

            except Exception as e:
                print(f"[!] Failed to transcribe {seg['file']}: {e}")
                print("    Progress so far is saved — rerun to continue.")
                break
            finally:
                if is_temp and seg_path and os.path.exists(seg_path):
                    try:
                        os.remove(seg_path)
                    except OSError:
                        pass
                # Light GC only every 15 segments — prioritise speed over peak-RAM shaving
                if n % 15 == 0:
                    free_memory()

        with open(manifest_path, "w", encoding="utf-8") as f:
            json.dump(manifest, f, indent=2)

        return done_count
    finally:
        if backend == "local":
            unload_transcribe_models()
        free_memory(aggressive=True)


def prompt_backend_choice() -> tuple:
    """Returns (backend, style, fixed_language|None, parallel_workers)."""
    print("\nWhich transcription backend?")
    print("  1. Groq API (needs API key(s), rate-limited) — best with parallel workers")
    print("  2. Local/Colab faster-whisper (uses GPU if available, no API key)")
    raw = input("Choose 1 or 2 (default 1): ").strip()
    backend = "local" if raw == "2" else "groq"

    print("\nWhich model style?")
    print("  1. turbo    - faster")
    print("  2. large-v3 - slower, max accuracy")
    raw2 = input("Choose 1 or 2 (default 1): ").strip()
    style = "large" if raw2 == "2" else "turbo"

    print("\nLanguage mode:")
    print("  - Press Enter for AUTO (detect per segment; may drop context on language switches)")
    print("  - Or type a code to LOCK one language for the whole run (e.g. en, es, ja, zh, pt)")
    lang_raw = input("Language (default auto): ").strip().lower()
    fixed_language = lang_raw if lang_raw else None
    if fixed_language:
        print(f"[+] Locked language: {fixed_language} (no switch detection)")

    workers = 1
    if backend == "groq":
        raw_w = input(
            "Parallel Groq workers? (1 = sequential with full context, "
            "4–8 = much faster, default 4): "
        ).strip()
        try:
            workers = int(raw_w) if raw_w else 4
        except ValueError:
            workers = 4
        workers = max(1, min(workers, 16))
    else:
        print("[+] Local mode: sequential GPU inference (fastest for a single model).")

    return backend, style, fixed_language, workers


def resolve_manifest_choice() -> str:
    manifests = sorted(glob.glob(os.path.join(SEGMENTS_ROOT, "*", "manifest.json")))
    if manifests:
        print("\n[+] Found manifest(s) under Drive segments folder:")
        for i, m in enumerate(manifests, 1):
            print(f"  {i}. {m}")
        raw = input("Pick a number, or paste a manifest.json path directly: ").strip()
        if raw.isdigit() and 1 <= int(raw) <= len(manifests):
            return manifests[int(raw) - 1]
        return raw
    return input("Path to manifest.json: ").strip()


def do_transcribe_mode(manifest_path: str = None):
    manifest_path = manifest_path or resolve_manifest_choice()
    if not os.path.exists(manifest_path):
        print(f"[!] Manifest not found: {manifest_path}")
        return
    backend, style, fixed_language, workers = prompt_backend_choice()
    transcripts_dirs = [DEFAULT_TRANSCRIPTS_DIR, os.path.dirname(manifest_path), os.getcwd()]
    n = auto_transcribe_missing(
        manifest_path, transcripts_dirs, backend, style,
        fixed_language=fixed_language, parallel_workers=workers,
    )
    print(f"[+] Transcribed {n} segment(s).")


