def _load_wav_mono_float32(path: str, target_sr: int = 16000):
    """Load a WAV as mono float32 numpy."""
    import numpy as np
    try:
        import soundfile as sf
        data, sr = sf.read(path, dtype="float32", always_2d=False)
        if data.ndim > 1:
            data = data.mean(axis=1)
        if sr != target_sr:
            duration = len(data) / float(sr)
            new_len = int(duration * target_sr)
            x_old = np.linspace(0.0, 1.0, num=len(data), endpoint=False)
            x_new = np.linspace(0.0, 1.0, num=new_len, endpoint=False)
            data = np.interp(x_new, x_old, data).astype(np.float32)
            sr = target_sr
        return data.astype(np.float32), sr
    except Exception:
        from pydub import AudioSegment
        seg = AudioSegment.from_file(path)
        seg = seg.set_channels(1).set_frame_rate(target_sr)
        samples = np.array(seg.get_array_of_samples()).astype(np.float32)
        if seg.sample_width == 2:
            samples /= 32768.0
        elif seg.sample_width == 4:
            samples /= 2147483648.0
        return samples, target_sr


# Overlaps shorter than this are skipped entirely (never sent to SepFormer).
# These are almost always short interjections ("yeah", "uh-huh") that add the
# least value per second of GPU time - filtering them is usually the single
# biggest speedup after raising the batch size. Tune between 0.3 (keep
# nearly everything) and 0.5 (aggressive - cuts region count by roughly half
# on typical conversational audio).
MIN_OVERLAP_DURATION = 0.45


def detect_overlap_regions_osd(audio_path: str, hf_token: str, min_duration_on: float = MIN_OVERLAP_DURATION,
                               min_duration_off: float = 0.1) -> list:
    """Run overlapped-speech detection. Returns list of {"start": float, "end": float}.

    Compatible with pyannote.audio 3.x and 4.x (OverlappedSpeechDetection was
    removed in 4.0). Tries three strategies in order:
      1. Official HF pipeline  pyannote/overlapped-speech-detection
      2. OverlappedSpeechDetection class (still present on 3.x)
      3. Inference on pyannote/segmentation-3.0 + second-max activation
    """
    import torch
    from pyannote.audio import Model, Pipeline, Inference
    from pyannote.audio.utils.signal import Binarize

    print("[+] Loading overlapped-speech detection...")

    # ---------- 1. Preferred: official HF pipeline ----------
    try:
        try:
            pipeline = Pipeline.from_pretrained(
                "pyannote/overlapped-speech-detection",
                token=hf_token
            )
        except TypeError:
            pipeline = Pipeline.from_pretrained(
                "pyannote/overlapped-speech-detection",
                use_auth_token=hf_token
            )
        if torch.cuda.is_available():
            pipeline.to(torch.device("cuda"))

        annotation = pipeline(audio_path)
        regions = []
        for segment in annotation.get_timeline().support():
            if segment.duration >= min_duration_on:
                regions.append({"start": float(segment.start), "end": float(segment.end)})
        regions.sort(key=lambda r: r["start"])
        print(f"[+] OSD (HF pipeline) found {len(regions)} overlap region(s).")
        del pipeline
        free_memory(aggressive=True)
        return regions
    except Exception as e:
        print(f"[~] Dedicated OSD pipeline failed ({e}). Trying alternatives...")

    # ---------- 2. Try the class if it still exists (pyannote 3.x) ----------
    try:
        from pyannote.audio.pipelines import OverlappedSpeechDetection
        try:
            seg_model = Model.from_pretrained("pyannote/segmentation-3.0", token=hf_token)
        except TypeError:
            seg_model = Model.from_pretrained("pyannote/segmentation-3.0", use_auth_token=hf_token)

        osd = OverlappedSpeechDetection(segmentation=seg_model)
        osd.instantiate({
            "min_duration_on": min_duration_on,
            "min_duration_off": min_duration_off,
        })
        if torch.cuda.is_available():
            osd.to(torch.device("cuda"))

        annotation = osd(audio_path)
        regions = []
        timeline = annotation.get_timeline().support() if hasattr(annotation, "get_timeline") else annotation
        for segment in timeline:
            regions.append({"start": float(segment.start), "end": float(segment.end)})
        regions.sort(key=lambda r: r["start"])
        print(f"[+] OSD (OverlappedSpeechDetection class) found {len(regions)} overlap region(s).")
        del osd, seg_model
        free_memory(aggressive=True)
        return regions
    except Exception as e:
        print(f"[~] OverlappedSpeechDetection class failed ({e}). Falling back to Inference...")

    # ---------- 3. Modern fallback: Inference on segmentation-3.0 + second max ----------
    try:
        try:
            model = Model.from_pretrained("pyannote/segmentation-3.0", token=hf_token)
        except TypeError:
            model = Model.from_pretrained("pyannote/segmentation-3.0", use_auth_token=hf_token)

        # second highest activation → overlapped speech score
        def to_osd(output):
            import numpy as np
            return np.partition(output, -2, axis=-1)[..., -2, np.newaxis]

        # Use the model's native training duration (10 s) to avoid the warning
        # and get better results. step=0.5 keeps good temporal resolution.
        inference = Inference(model, pre_aggregation_hook=to_osd, duration=10.0, step=0.5)
        if torch.cuda.is_available():
            inference.to(torch.device("cuda"))

        scores = inference(audio_path)
        binarize = Binarize(
            onset=0.5, offset=0.5,
            min_duration_on=min_duration_on,
            min_duration_off=min_duration_off,
        )
        annotation = binarize(scores)
        regions = []
        for segment in annotation.get_timeline().support():
            regions.append({"start": float(segment.start), "end": float(segment.end)})
        regions.sort(key=lambda r: r["start"])
        print(f"[+] OSD (Inference + 2nd-max) found {len(regions)} overlap region(s).")
        del inference, model
        free_memory(aggressive=True)
        return regions
    except Exception as e:
        print(f"[!] All OSD methods failed ({e}). Returning empty list.")
        free_memory(aggressive=True)
        return []


def resolve_overlaps_before_diarization(clean_path: str, hf_token: str) -> tuple:
    """Pre-diarization: OSD → SepFormer splice → return (wav_path, splice_manifest|None)."""
    try:
        regions = detect_overlap_regions_osd(clean_path, hf_token)
    except Exception as e:
        print(f"[!] Overlap detection failed ({e}). Continuing without SepFormer.")
        return clean_path, None

    if not regions:
        print("[+] No overlapping speech detected — skipping SepFormer.")
        return clean_path, None

    # Belt-and-suspenders filter: detect_overlap_regions_osd already asks
    # each backend for MIN_OVERLAP_DURATION, but not every fallback path
    # honors that param exactly the same way, so re-filter here too.
    n_before = len(regions)
    regions = [r for r in regions if (r["end"] - r["start"]) >= MIN_OVERLAP_DURATION]
    n_skipped = n_before - len(regions)
    if n_skipped:
        print(f"[+] Skipping {n_skipped} overlap region(s) shorter than {MIN_OVERLAP_DURATION:.2f}s "
              f"({len(regions)} remaining for SepFormer).")
    if not regions:
        print("[+] Nothing left after filtering short overlaps — skipping SepFormer.")
        return clean_path, None

    print(f"[+] Separating {len(regions)} overlap region(s) with SepFormer and splicing...")
    audio_np, sr = _load_wav_mono_float32(clean_path, target_sr=SAMPLE_RATE)
    basename = os.path.splitext(os.path.basename(clean_path))[0]
    # Per-file cache dir lives on DRIVE (not local /content), so it survives
    # a full Colab disconnect, not just a kernel restart - a retry only
    # separates whatever regions weren't finished yet. In normal operation
    # this stays tiny: separate_regions_resumable erases each region's cache
    # file as soon as it's consumed, so at most ~one batch's worth of region
    # files (a few MB) ever sits here, well under MAX_REGION_CACHE_BYTES.
    # Also wiped below once the splice fully succeeds - left in place on
    # any failure so the next attempt can resume instead of starting over.
    region_cache_dir = os.path.join(SEPFORMER_CACHE_ROOT, f"{basename}_sepformer_cache")
    try:
        import torch
        device = "cuda" if torch.cuda.is_available() else "cpu"
        separator = get_separator_model(device=device)
        new_audio, splice_manifest = splice_overlaps_into_audio(
            audio_np, sr, regions, separator, cache_dir=region_cache_dir
        )
    except Exception as e:
        print(f"[!] SepFormer splice failed ({e}). Continuing on original audio.")
        print(f"    (Partial progress kept in {region_cache_dir} - rerun to resume.)")
        return clean_path, None
    finally:
        try:
            unload_separator_model()
        except Exception:
            pass
        free_memory(aggressive=True)

    if not splice_manifest or not splice_manifest.get("splices"):
        print("[+] SepFormer produced no splices — using original audio.")
        return clean_path, None

    spliced_path = os.path.join(NORMALIZED_DIR, f"{basename}_spliced.wav")
    try:
        import soundfile as sf
        sf.write(spliced_path, new_audio, sr, subtype="PCM_16")
    except Exception:
        from pydub import AudioSegment
        import numpy as np
        pcm = (np.clip(new_audio, -1.0, 1.0) * 32767.0).astype(np.int16)
        seg = AudioSegment(pcm.tobytes(), frame_rate=sr, sample_width=2, channels=1)
        seg.export(spliced_path, format="wav")

    # Splice succeeded end-to-end - the per-region cache has done its job, drop it.
    shutil.rmtree(region_cache_dir, ignore_errors=True)

    n_splices = len(splice_manifest["splices"])
    dur_orig = len(audio_np) / float(sr)
    dur_new = len(new_audio) / float(sr)
    print(f"[OK] Spliced audio written: {spliced_path}")
    print(f"     {n_splices} region(s) separated | "
          f"duration {dur_orig/60:.1f} min → {dur_new/60:.1f} min (spliced timeline)")
    print(f"     Timestamps will be remapped back to the original timeline on REASSEMBLE.")
    return spliced_path, splice_manifest


def remap_entries_to_original(entries: list, splice_manifest: dict) -> list:
    """Transcript compiler: spliced timeline → original timeline."""
    remapped = remap_segments_to_original(entries, splice_manifest)
    for e in remapped:
        e["start"] = round(float(e["start"]), 3)
        e["end"] = round(float(e["end"]), 3)
        if e["end"] < e["start"]:
            e["end"] = e["start"]
    return remapped


def split_file(audio_path: str, merge_gap: float, min_segment: float, do_langid: bool, hf_token: str,
               write_segment_wavs: bool = None, resolve_overlaps: bool = False):
    """Diarize and write a lightweight manifest of timestamps.
    By default does NOT write per-turn WAV files (they are reconstructed later
    from the normalized full audio using the timestamps). Set write_segment_wavs=True
    (or the global WRITE_SEGMENT_WAVS) if you still want the old behaviour.

    Memory notes (Colab-critical):
    - Never loads the full normalized audio into pydub unless permanent WAVs are
      requested. Language-ID uses short-lived ffmpeg slices only.
    - Unloads the langid model after the loop so its RAM/VRAM is free before
      the next file (or before TRANSCRIBE starts).
    """
    if write_segment_wavs is None:
        write_segment_wavs = WRITE_SEGMENT_WAVS

    # Normalize first so pyannote never sees the original OGG/MP3 (stays local)
    clean_path = normalize_audio_for_diarization(audio_path)
    original_normalized = clean_path
    splice_manifest = None

    # Optional: separate overlapping speech BEFORE diarization (easier + cleaner)
    if resolve_overlaps:
        clean_path, splice_manifest = resolve_overlaps_before_diarization(clean_path, hf_token)
        # clean_path may now be the longer spliced WAV; diarize that

    turns = run_diarization(clean_path, hf_token)
    turns = merge_and_filter(turns, merge_gap, min_segment)
    if not turns:
        print(f"[!] No speaker turns detected in '{audio_path}'. Skipping.")
        return None

    print(f"[+] {len(turns)} speaker turn(s) after merge/filter"
          f"{' (on spliced timeline)' if splice_manifest else ''}.")

    basename = os.path.splitext(os.path.basename(audio_path))[0]
    out_dir = os.path.join(SEGMENTS_ROOT, basename)
    os.makedirs(out_dir, exist_ok=True)

    # Only load full audio into memory if we actually write permanent WAVs
    audio = None
    if write_segment_wavs:
        from pydub import AudioSegment
        print("[+] Loading normalized audio to write permanent per-turn WAVs...")
        audio = AudioSegment.from_file(clean_path)

    manifest = {
        "source_file": os.path.abspath(audio_path),
        "normalized_audio": clean_path,  # may be spliced — used for slice reconstruction
        "original_normalized_audio": original_normalized,
        "splice_manifest": splice_manifest,  # None if overlaps were not resolved
        "segments": [],
    }

    try:
        for i, (start_sec, end_sec, speaker) in enumerate(turns, start=1):
            seg_filename = f"seg_{i:04d}_{speaker}.wav"
            seg_path = os.path.join(out_dir, seg_filename) if write_segment_wavs else None

            if write_segment_wavs and audio is not None:
                audio[int(start_sec * 1000):int(end_sec * 1000)].export(seg_path, format="wav")

            language, language_prob = (None, None)
            if do_langid:
                try:
                    if write_segment_wavs and seg_path and os.path.exists(seg_path):
                        language, language_prob = detect_language(seg_path)
                    else:
                        # Extract a short-lived temp slice via ffmpeg (never holds full audio)
                        tmp_slice = os.path.join(TEMP_SLICES_DIR, f"langid_{basename}_{i:04d}.wav")
                        extract_segment_slice(clean_path, start_sec, end_sec, out_path=tmp_slice)
                        language, language_prob = detect_language(tmp_slice)
                        try:
                            os.remove(tmp_slice)
                        except OSError:
                            pass
                except Exception as e:
                    print(f"[!] Language ID failed on segment {i}: {e}")

            manifest["segments"].append({
                "index": i,
                "file": seg_filename,               # kept for transcript naming compatibility
                "speaker": speaker,
                "start_sec": round(start_sec, 3),
                "end_sec": round(end_sec, 3),
                "language": language,
                "language_prob": language_prob,
            })

            lang_note = f", lang={language} ({language_prob})" if language else ""
            wav_note = " [WAV written]" if write_segment_wavs else ""
            print(f"  [{i}/{len(turns)}] {seg_filename}  {start_sec:.2f}s-{end_sec:.2f}s  {speaker}{lang_note}{wav_note}")
    finally:
        # Release the optional full-audio buffer + language-ID model immediately
        if audio is not None:
            del audio
        unload_langid_model()
        free_memory(aggressive=True)

    manifest_path = os.path.join(out_dir, "manifest.json")
    with open(manifest_path, "w", encoding="utf-8") as f:
        json.dump(manifest, f, indent=2)

    if write_segment_wavs:
        print(f"[SUCCESS] Per-turn WAVs + manifest written to: {out_dir}")
    else:
        print(f"[SUCCESS] Lightweight manifest written to: {out_dir}")
        print(f"          (no permanent per-turn WAVs – will reconstruct from normalized audio on demand)")
    return manifest_path


def ensure_normalized_audio(manifest: dict) -> str:
    """Return a usable path to the normalized full audio.
    Prefers the path stored in the manifest; if missing, re-normalizes from source_file."""
    norm = manifest.get("normalized_audio")
    if norm and os.path.exists(norm) and os.path.getsize(norm) > 0:
        return norm

    source = manifest.get("source_file")
    if source and os.path.exists(source):
        print("[+] Normalized audio missing – re-creating from source_file...")
        return normalize_audio_for_diarization(source)

    raise FileNotFoundError(
        "Neither normalized_audio nor source_file is available. "
        "Cannot reconstruct segments. Re-run SPLIT mode."
    )


def extract_segment_slice(normalized_path: str, start_sec: float, end_sec: float,
                          out_path: str = None) -> str:
    """Cut [start_sec:end_sec] from the normalized full audio into a short-lived temp file.
    Returns the path to the temp slice. Caller is responsible for deleting it after use.
    Prefer ffmpeg (no full-file RAM load). pydub fallback only if ffmpeg fails."""
    if out_path is None:
        os.makedirs(TEMP_SLICES_DIR, exist_ok=True)
        out_path = os.path.join(
            TEMP_SLICES_DIR,
            f"slice_{int(start_sec*1000)}_{int(end_sec*1000)}_{os.getpid()}.wav"
        )

    try:
        subprocess.run(
            [
                "ffmpeg", "-y",
                "-ss", str(start_sec),
                "-to", str(end_sec),
                "-i", normalized_path,
                "-ac", "1", "-ar", "16000", "-sample_fmt", "s16",
                out_path,
            ],
            check=True, capture_output=True,
        )
    except Exception:
        # Last-resort: load only the needed region if possible; still better than
        # crashing the whole pipeline. Prefer this never runs on Colab.
        from pydub import AudioSegment
        audio = AudioSegment.from_file(normalized_path)
        audio[int(start_sec * 1000):int(end_sec * 1000)].export(out_path, format="wav")
        del audio
        free_memory()

    return out_path


def get_segment_audio_path(manifest: dict, seg: dict, seg_dir: str) -> tuple:
    """Return (path_to_audio, is_temporary).
    Prefer an existing permanent WAV (legacy); otherwise reconstruct a temp slice
    from the normalized full audio using the timestamps in the manifest."""
    legacy = os.path.join(seg_dir, seg["file"])
    if os.path.exists(legacy) and os.path.getsize(legacy) > 0:
        return legacy, False

    norm = ensure_normalized_audio(manifest)
    tmp = extract_segment_slice(norm, seg["start_sec"], seg["end_sec"])
    return tmp, True


