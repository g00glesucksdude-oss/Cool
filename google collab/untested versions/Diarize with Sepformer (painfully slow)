def do_prep_mode():
    """Download + normalize audio only. Pure ffmpeg/I-O work - deliberately
    doesn't call run_diarization/OSD/SepFormer, so it's cheap on a CPU
    runtime and doesn't burn GPU/TPU session time on work that doesn't
    benefit from it. Saves the normalized WAV(s) + your settings to Drive.

    Workflow: run this on a CPU runtime, then switch the Colab runtime to
    GPU/TPU and run SPLIT or FULL RUN - they'll detect these prepped files
    and skip straight to diarization instead of re-downloading/re-normalizing
    on paid accelerator time.
    """
    files = select_audio_files_split()
    if not files:
        print("[!] No audio files selected.")
        return []

    raw = input(f"Merge same-speaker gaps under how many seconds? (default {DEFAULT_MERGE_GAP}): ").strip()
    merge_gap = float(raw) if raw else DEFAULT_MERGE_GAP
    raw = input(f"Drop segments shorter than how many seconds? (default {DEFAULT_MIN_SEGMENT}): ").strip()
    min_segment = float(raw) if raw else DEFAULT_MIN_SEGMENT
    do_langid = input("Run per-segment language ID later? (Y/n): ").strip().lower() != "n"
    write_wavs = input(
        "Also write permanent per-turn WAV files later? (rarely needed) (y/N): "
    ).strip().lower() == "y"
    resolve_overlaps = input(
        "Resolve overlapping speech with SepFormer later (during RUN)? (y/N): "
    ).strip().lower() == "y"

    entries = _load_prep_manifest()
    for f in files:
        if not os.path.exists(f):
            print(f"[!] File not found, skipping: {f}")
            continue
        print(f"[+] Prepping '{f}' (download/normalize only - no GPU/TPU used)...")
        clean_path = normalize_audio_for_diarization(f)  # ffmpeg only, no torch/model load
        drive_copy = os.path.join(PREP_AUDIO_DIR, os.path.basename(clean_path))
        shutil.copy2(clean_path, drive_copy)
        entries.append({
            "source_file": os.path.abspath(f),
            "prepped_audio": drive_copy,
            "merge_gap": merge_gap,
            "min_segment": min_segment,
            "do_langid": do_langid,
            "write_wavs": write_wavs,
            "resolve_overlaps": resolve_overlaps,
        })
        print(f"[OK] Prepped → {drive_copy} ({os.path.getsize(drive_copy)/1_000_000:.1f} MB on Drive)")

    _save_prep_manifest(entries)
    print(f"\n[SUCCESS] {len(entries)} file(s) waiting on Drive, ready for a GPU/TPU run.")
    print("          Switch the runtime now, then choose SPLIT or FULL RUN.")
    return entries


def _consume_prepped_files(hf_token: str) -> list:
    """If PREP mode already ran, offer to use those files instead of asking
    to select/normalize again. Returns manifest_paths from anything split
    this way; each entry's Drive copy is deleted once consumed so the prep
    area never accumulates."""
    prepped = _load_prep_manifest()
    if not prepped:
        return []

    print(f"\n[+] Found {len(prepped)} file(s) already prepped (downloaded + normalized) on Drive.")
    use_prepped = input("    Use them now instead of prepping again? (Y/n): ").strip().lower() != "n"
    if not use_prepped:
        return []

    manifest_paths = []
    remaining = []
    for entry in prepped:
        prepped_audio = entry.get("prepped_audio")
        if not prepped_audio or not os.path.exists(prepped_audio):
            print(f"[!] Prepped audio missing for '{entry.get('source_file')}', skipping (will need re-prep).")
            continue
        clean_local = os.path.join(NORMALIZED_DIR, os.path.basename(prepped_audio))
        if not os.path.exists(clean_local):
            shutil.copy2(prepped_audio, clean_local)
        mp = split_file(
            entry["source_file"], entry.get("merge_gap", DEFAULT_MERGE_GAP),
            entry.get("min_segment", DEFAULT_MIN_SEGMENT), entry.get("do_langid", True), hf_token,
            write_segment_wavs=entry.get("write_wavs", False),
            resolve_overlaps=entry.get("resolve_overlaps", False),
        )
        if mp:
            manifest_paths.append(mp)
        # consumed - erase the Drive copy now so prep storage never accumulates
        try:
            os.remove(prepped_audio)
        except OSError:
            pass

    _save_prep_manifest(remaining)  # remaining is [] unless something above chose to keep an entry
    return manifest_paths


def do_split_mode(prompt_for_settings: bool = True):
    hf_token = get_hf_token()
    if not hf_token:
        print("[!] No Hugging Face token provided. pyannote needs one. Aborting split.")
        return []

    manifest_paths = _consume_prepped_files(hf_token)

    if manifest_paths and prompt_for_settings:
        more = input("\nPrep/split any additional files now? (y/N): ").strip().lower() == "y"
        if not more:
            return manifest_paths
    elif manifest_paths and not prompt_for_settings:
        # Called from FULL RUN - prepped files are already fully split; don't
        # also prompt for a brand-new interactive batch on top of them.
        return manifest_paths

    files = select_audio_files_split()
    if not files:
        if manifest_paths:
            return manifest_paths
        print("[!] No audio files selected.")
        return []

    merge_gap, min_segment, do_langid = DEFAULT_MERGE_GAP, DEFAULT_MIN_SEGMENT, True
    write_wavs = WRITE_SEGMENT_WAVS
    resolve_overlaps = False
    if prompt_for_settings:
        raw = input(f"Merge same-speaker gaps under how many seconds? (default {DEFAULT_MERGE_GAP}): ").strip()
        merge_gap = float(raw) if raw else DEFAULT_MERGE_GAP
        raw = input(f"Drop segments shorter than how many seconds? (default {DEFAULT_MIN_SEGMENT}): ").strip()
        min_segment = float(raw) if raw else DEFAULT_MIN_SEGMENT
        do_langid = input("Run per-segment language ID? (Y/n): ").strip().lower() != "n"
        write_wavs = input(
            "Also write permanent per-turn WAV files? (rarely needed, uses lots of space) (y/N): "
        ).strip().lower() == "y"
        resolve_overlaps = input(
            "Resolve overlapping speech with SepFormer BEFORE diarization?\n"
            "  (detects crosstalk, separates voices, splices them so diarization sees clean turns;\n"
            "   timestamps are remapped back to the original timeline on REASSEMBLE) (y/N): "
        ).strip().lower() == "y"

    for f in files:
        if not os.path.exists(f):
            print(f"[!] File not found, skipping: {f}")
            continue
        mp = split_file(
            f, merge_gap, min_segment, do_langid, hf_token,
            write_segment_wavs=write_wavs, resolve_overlaps=resolve_overlaps,
        )
        if mp:
            manifest_paths.append(mp)
    return manifest_paths


