import os
import subprocess

def fast_split_audio_by_hour(input_file_path, output_folder="output_chunks"):
    if not os.path.exists(input_file_path):
        print(f"Error: File '{input_file_path}' not found.")
        return

    os.makedirs(output_folder, exist_ok=True)
    base_name, ext = os.path.splitext(os.path.basename(input_file_path))
    output_pattern = os.path.join(output_folder, f"{base_name}_part_%02d{ext}")

    # FFmpeg command to split every 3600 seconds (1 hour) without re-encoding
    cmd = [
        "ffmpeg",
        "-i", input_file_path,
        "-f", "segment",
        "-segment_time", "3600",
        "-c", "copy",
        output_pattern
    ]

    print("Splitting audio instantly...")
    subprocess.run(cmd, check=True)
    print("Done! Check the 'output_chunks' folder.")

if __name__ == "__main__":
    file_to_split = "your_long_audio_file.mp3"  # Replace with your file
    fast_split_audio_by_hour(file_to_split)
 
